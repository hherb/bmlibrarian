{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BMLibrarian",
  "version": "0.1.0",
  "identifier": "org.bmlibrarian.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BMLibrarian",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
